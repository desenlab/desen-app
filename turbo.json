{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../tsconfig.base.json"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../scripts/lib/protocol-snapshot-integrity.mjs",
        "../../scripts/lib/protocol-types.mjs",
        "../../scripts/lib/protocol-canonicalization-proof.mjs",
        "../../scripts/lib/protocol-component-contracts-proof.mjs",
        "../../scripts/lib/protocol-diagnostics-proof.mjs",
        "../../scripts/lib/protocol-semantic-foundation-proof.mjs",
        "../../scripts/lib/protocol-structural-validation-proof.mjs",
        "../../tests/protocol-canonicalization.test.mjs",
        "../../tests/protocol-component-contracts.test.mjs",
        "../../tests/protocol-diagnostics.test.mjs",
        "../../tests/protocol-semantic-foundation.test.mjs",
        "../../tests/protocol-snapshot-integrity.test.mjs",
        "../../tests/protocol-structural-validation.test.mjs",
        "../../tests/protocol-types.test.mjs"
      ],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../scripts/lib/protocol-snapshot-integrity.mjs",
        "../../scripts/lib/protocol-types.mjs",
        "../../scripts/lib/protocol-canonicalization-proof.mjs",
        "../../scripts/lib/protocol-component-contracts-proof.mjs",
        "../../scripts/lib/protocol-diagnostics-proof.mjs",
        "../../scripts/lib/protocol-semantic-foundation-proof.mjs",
        "../../scripts/lib/protocol-structural-validation-proof.mjs",
        "../../tests/protocol-canonicalization.test.mjs",
        "../../tests/protocol-component-contracts.test.mjs",
        "../../tests/protocol-diagnostics.test.mjs",
        "../../tests/protocol-semantic-foundation.test.mjs",
        "../../tests/protocol-snapshot-integrity.test.mjs",
        "../../tests/protocol-structural-validation.test.mjs",
        "../../tests/protocol-types.test.mjs"
      ],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "proof": {
      "dependsOn": ["build", "test"],
      "outputs": ["artifacts/proof/**"]
    }
  }
}
