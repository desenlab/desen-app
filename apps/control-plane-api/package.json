{
  "name": "@desen/control-plane-api",
  "version": "0.0.0",
  "private": true,
  "description": "Local DESEN control plane for editable Sources, immutable Bundles, mutable channels, and staged runtime candidates.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate:bundle-verification-guards": "node scripts/generate-bundle-verification-guards.mjs",
    "generate:package-preflight-catalog-guard": "node scripts/generate-package-preflight-catalog-guard.mjs",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:local-api": "vitest run test/local-control-plane.test.ts",
    "test:package-preflight": "vitest run test/package-preflight.test.ts test/package-preflight-schema-guard.test.ts",
    "test:reference-preflight": "vitest run test/reference-preflight.test.ts",
    "test:runtime-staging": "vitest run test/runtime-staging.test.ts",
    "test:runtime-activation": "vitest run test/runtime-activation.test.ts",
    "test:bundle-verification": "vitest run test/bundle-verification.test.ts test/bundle-verification-guard.test.ts",
    "test:bundle-store": "vitest run test/bundle-store.test.ts",
    "verify:bundle-verification-guards": "node scripts/verify-bundle-verification-guards.mjs",
    "verify:package-preflight-catalog-guard": "node scripts/verify-package-preflight-catalog-guard.mjs",
    "verify:package-preflight-guards": "pnpm run verify:package-preflight-catalog-guard"
  },
  "dependencies": {
    "@desen/protocol": "workspace:*",
    "@desen/runtime-core": "workspace:*",
    "@desen/validator": "workspace:*",
    "better-sqlite3": "13.0.3",
    "fastify": "5.11.2"
  },
  "devDependencies": {
    "@desen/publisher": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "ajv": "8.20.0",
    "prettier": "3.9.6",
    "vitest": "4.1.10"
  }
}
