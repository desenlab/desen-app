{
  "kind": "desen.bundle",
  "desen": "0.1.0",
  "id": "com.example.account-app",
  "revision": "sha256:2dc98d276a3b4102c2891de1519bda86ea2978f5429fd8ea91831f36f8b73ffb",
  "sourceDigest": "sha256:b8e2d6bac855fb307aaeb0636becf93834f6faeda5464bdbfbc1e8d52f379635",
  "requires": {
    "catalogs": [
      {
        "id": "run.desen.reference.sign-in",
        "version": "0.1.0",
        "target": "web-react",
        "digest": "sha256:acdbbfe9ad4c1fce8093b0b68036bc7f5678e8b2a603357dbe25f2413a3db6f0"
      }
    ]
  },
  "entry": "sign-in",
  "surfaces": {
    "sign-in": {
      "id": "sign-in",
      "state": {
        "email": {
          "schema": {
            "type": "string"
          },
          "initial": ""
        },
        "password": {
          "schema": {
            "type": "string"
          },
          "initial": ""
        }
      },
      "resources": {},
      "root": {
        "id": "sign-in.layout",
        "use": "com.example.ui/Stack",
        "props": {
          "direction": "vertical",
          "gap": "md",
          "maxWidth": 420
        },
        "slots": {
          "default": [
            {
              "id": "sign-in.title",
              "use": "com.example.ui/Text",
              "props": {
                "text": "Sign in",
                "role": "heading"
              }
            },
            {
              "id": "sign-in.email",
              "use": "com.example.ui/TextField",
              "props": {
                "label": "Email",
                "value": {
                  "$ref": "state.email"
                }
              },
              "on": {
                "change": [
                  {
                    "type": "state.set",
                    "path": "email",
                    "value": {
                      "$ref": "event.value"
                    }
                  }
                ]
              }
            },
            {
              "id": "sign-in.password",
              "use": "com.example.ui/TextField",
              "props": {
                "label": "Password",
                "secure": true,
                "value": {
                  "$ref": "state.password"
                }
              },
              "on": {
                "change": [
                  {
                    "type": "state.set",
                    "path": "password",
                    "value": {
                      "$ref": "event.value"
                    }
                  }
                ]
              }
            },
            {
              "id": "sign-in.error",
              "use": "com.example.ui/Alert",
              "when": {
                "op": "eq",
                "args": [
                  {
                    "$ref": "operation.signIn.status"
                  },
                  "failed"
                ]
              },
              "props": {
                "tone": "critical",
                "text": "Sign-in failed. Check your details and try again."
              }
            },
            {
              "id": "sign-in.submit",
              "use": "com.example.ui/Button",
              "props": {
                "label": "Sign in",
                "variant": "primary",
                "loading": {
                  "$ref": "operation.signIn.pending",
                  "fallback": false
                }
              },
              "on": {
                "press": [
                  {
                    "type": "operation.invoke",
                    "operation": "com.example.auth/signIn",
                    "as": "signIn",
                    "input": {
                      "email": {
                        "$ref": "state.email"
                      },
                      "password": {
                        "$ref": "state.password"
                      }
                    },
                    "concurrency": "replace",
                    "onSuccess": [
                      {
                        "type": "navigate",
                        "surface": "home"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "home": {
      "id": "home",
      "state": {},
      "resources": {},
      "root": {
        "id": "home.layout",
        "use": "com.example.ui/Stack",
        "props": {
          "direction": "vertical",
          "gap": "md"
        },
        "slots": {
          "default": [
            {
              "id": "home.title",
              "use": "com.example.ui/Text",
              "props": {
                "text": "Welcome",
                "role": "heading"
              }
            }
          ]
        }
      }
    }
  },
  "publication": {
    "publishedAt": "2026-07-21T00:00:00Z",
    "publisher": "desen-example-publisher/0.1.0"
  },
  "extensions": {}
}
