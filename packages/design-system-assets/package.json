{
  "name": "@desen/design-system-assets",
  "version": "0.0.0",
  "private": true,
  "description": "Safe local image, icon and font assets for DESEN authoring.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@desen/protocol": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
