            }
          }
        }
      },
      "commands": {
        "focus": {
          "inputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false
          }
        }
      },
      "styleParts": {
        "root": {
          "propertiesSchema": {
            "type": "object"
