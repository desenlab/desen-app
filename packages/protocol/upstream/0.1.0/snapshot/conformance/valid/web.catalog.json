    "com.example.maps/Map": {
      "description": "Interactive store map backed by a host-selected map library.",
      "category": "complex",
      "propsSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "center",
          "zoom",
          "mapStyle"
        ],
        "properties": {
          "center": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "latitude",
              "longitude"
            ],
            "properties": {
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            }
          },
          "zoom": {
            "type": "number",
            "minimum": 0,
            "maximum": 24
          },
          "mapStyle": {
            "type": "string",
            "enum": [
              "light",
              "dark",
              "satellite"
            ]
          },
          "showControls": {
            "type": "boolean"
          }
        }
      },
