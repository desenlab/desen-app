        "displayName": "Text field",
        "category": "Inputs",
        "icon": "text-field",
        "defaultProps": {
          "label": "Label",
          "value": ""
        },
        "scenarios": {
          "default": {
            "props": {
              "label": "Email",
              "value": ""
