{
  "name": "@desen/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Frozen protocol artifacts, derived types, stable diagnostics, and deterministic digest primitives.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test ../../tests/protocol-snapshot-integrity.test.mjs ../../tests/protocol-types.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage ../../tests/protocol-snapshot-integrity.test.mjs ../../tests/protocol-types.test.mjs"
  }
}
