{
  "name": "@desen/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Frozen protocol artifacts, derived types, stable diagnostics, and deterministic digest primitives.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/canonicalization.test.ts",
    "test:coverage": "vitest run test/canonicalization.test.ts --coverage"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
