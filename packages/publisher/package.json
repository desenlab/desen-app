{
  "name": "@desen/publisher",
  "version": "0.0.0",
  "private": true,
  "description": "Pure, deterministic DESEN Source to immutable Bundle publication orchestration.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:catalog-resolution": "vitest run test/catalog-resolution.test.ts",
    "test:publish-result": "vitest run test/publish-result.test.ts",
    "test:source-preflight": "vitest run test/source-preflight.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@desen/protocol": "workspace:*",
    "@desen/validator": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
