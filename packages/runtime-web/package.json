{
  "name": "@desen/runtime-web",
  "version": "0.0.0",
  "private": true,
  "description": "Browser host ports, channel fetching, navigation bridge, and persistent last-known-good activation.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:host-authority": "vitest run test/host-authority.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@desen/runtime-core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
