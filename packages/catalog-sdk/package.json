{
  "name": "@desen/catalog-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Typed capability manifest registration and parity tooling with manifest authority.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:manifest-derivation": "vitest run test/component-inspector-control.test.ts",
    "test:manifest-registration": "vitest run test/catalog-manifest-registration.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@desen/protocol": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
