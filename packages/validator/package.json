{
  "name": "@desen/validator",
  "version": "0.0.0",
  "private": true,
  "description": "Structural and semantic validation against exact DESEN protocol and catalog contracts.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "generate:structural-validation": "node scripts/generate-structural-validators.mjs",
    "lint": "eslint src test --max-warnings=0",
    "verify:structural-validation": "node scripts/verify-structural-validators.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:semantic-foundation": "vitest run test/semantic-foundation.test.ts",
    "test:structural-validation": "vitest run test/structural-validation.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@desen/protocol": "workspace:*"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "prettier": "3.9.6",
    "vitest": "4.1.10"
  }
}
