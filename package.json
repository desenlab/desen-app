{
  "name": "desen-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Reference implementation and developer ecosystem for DESEN 0.1.0.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint . --max-warnings=0 && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:protocol-snapshot && pnpm test:protocol-traceability && pnpm test:protocol-types && pnpm test:protocol-canonicalization && pnpm test:protocol-diagnostics && pnpm test:protocol-structural-validation && pnpm test:protocol-semantic-foundation && pnpm test:protocol-component-contracts && pnpm test:protocol-interaction-contracts && pnpm test:protocol-binding-contracts && turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "node scripts/not-implemented.mjs browser-e2e G10",
    "proof": "node scripts/not-implemented.mjs protocol-proof-runner G10",
    "verify:protocol-snapshot": "node scripts/verify-protocol-snapshot.mjs",
    "test:protocol-snapshot": "node --test tests/protocol-snapshot-integrity.test.mjs",
    "verify:protocol-traceability": "node scripts/verify-protocol-traceability.mjs",
    "test:protocol-traceability": "node --test tests/protocol-traceability.test.mjs",
    "generate:protocol-types": "node scripts/generate-protocol-types.mjs",
    "verify:protocol-types": "node scripts/verify-protocol-types.mjs",
    "test:protocol-types": "node --test tests/protocol-types.test.mjs",
    "generate:protocol-canonicalization": "node scripts/generate-protocol-canonicalization-proof.mjs",
    "verify:protocol-canonicalization": "node scripts/verify-protocol-canonicalization.mjs",
    "test:protocol-canonicalization": "pnpm --filter @desen/protocol test:canonicalization && node --test tests/protocol-canonicalization.test.mjs",
    "generate:protocol-diagnostics": "node scripts/generate-protocol-diagnostics-proof.mjs",
    "verify:protocol-diagnostics": "node scripts/verify-protocol-diagnostics.mjs",
    "test:protocol-diagnostics": "pnpm --filter @desen/protocol test:diagnostics && node --test tests/protocol-diagnostics.test.mjs",
    "generate:protocol-structural-validation": "pnpm --filter @desen/validator generate:structural-validation && pnpm --filter @desen/validator... build && node scripts/generate-protocol-structural-validation-proof.mjs",
    "verify:protocol-structural-validation": "pnpm --filter @desen/validator verify:structural-validation && pnpm --filter @desen/validator... build && node scripts/verify-protocol-structural-validation.mjs",
    "test:protocol-structural-validation": "pnpm --filter @desen/validator... build && pnpm --filter @desen/validator test:structural-validation && node --test tests/protocol-structural-validation.test.mjs",
    "generate:protocol-semantic-foundation": "pnpm --filter @desen/validator... build && node scripts/generate-protocol-semantic-foundation-proof.mjs",
    "verify:protocol-semantic-foundation": "pnpm --filter @desen/validator... build && node scripts/verify-protocol-semantic-foundation.mjs",
    "test:protocol-semantic-foundation": "pnpm --filter @desen/validator... build && pnpm --filter @desen/validator test:semantic-foundation && node --test tests/protocol-semantic-foundation.test.mjs",
    "generate:protocol-component-contracts": "pnpm --filter @desen/validator... build && node scripts/generate-protocol-component-contracts-proof.mjs",
    "verify:protocol-component-contracts": "pnpm --filter @desen/validator... build && node scripts/verify-protocol-component-contracts.mjs",
    "test:protocol-component-contracts": "pnpm --filter @desen/validator... build && pnpm --filter @desen/validator test:component-contracts && node --test tests/protocol-component-contracts.test.mjs",
    "generate:protocol-interaction-contracts": "pnpm --filter @desen/validator... build && node scripts/generate-protocol-interaction-contracts-proof.mjs",
    "verify:protocol-interaction-contracts": "pnpm --filter @desen/validator... build && node scripts/verify-protocol-interaction-contracts.mjs",
    "test:protocol-interaction-contracts": "pnpm --filter @desen/validator... build && pnpm --filter @desen/validator test:interaction-contracts && node --test tests/protocol-interaction-contracts.test.mjs",
    "generate:protocol-binding-contracts": "pnpm --filter @desen/validator... build && node scripts/generate-protocol-binding-contracts-proof.mjs",
    "verify:protocol-binding-contracts": "pnpm --filter @desen/validator... build && node scripts/verify-protocol-binding-contracts.mjs",
    "test:protocol-binding-contracts": "pnpm --filter @desen/validator... build && pnpm --filter @desen/validator test:binding-contracts && node --test tests/protocol-binding-contracts.test.mjs",
    "boundaries": "depcruise --config dependency-cruiser.config.cjs apps packages && node scripts/verify-boundary-fixtures.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm format:check && pnpm verify:protocol-snapshot && pnpm verify:protocol-traceability && pnpm verify:protocol-types && pnpm verify:protocol-canonicalization && pnpm verify:protocol-diagnostics && pnpm verify:protocol-structural-validation && pnpm verify:protocol-semantic-foundation && pnpm verify:protocol-component-contracts && pnpm verify:protocol-interaction-contracts && pnpm verify:protocol-binding-contracts && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm boundaries",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node --eval \"throw new Error('External publishing is reserved until G12 and explicit approval; follow docs/release/NPM-TRANSITION.md')\""
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.9.6",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
